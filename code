// clear the screen
void clearScreen() {
    cout << "\033[2J\033[1;1H";
}

// get the topic that the student wants
int AskTopic(const string topicname[]) {
    int topicindex;
    cout << "What topic do you want to learn?" << endl;
    for (int i = 0; i < 8; i++) {
        cout << (i + 1) << " for " << topicname[i] << endl;
    }

    do {
        cout << "Enter your choice (1-8): ";
        cin >> topicindex;

        // Prevent character input
        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input! Please enter a number." << endl;
            topicindex = 0;
            continue;
        }
		//prevent out of range input
        if (topicindex < 1 || topicindex > 8) {
            cout << "Invalid choice! Please enter a number between 1 and 8." << endl;
        }
    } while (topicindex < 1 || topicindex > 8);

    return topicindex;
}

// Print the board 
void printBoard(string name, int player_position = 1) {
    cout << "User: " << name << endl;
    cout << "-------------------------------------------------------------" << endl;


    cout << "|";
    for (int i = 1; i <= 9; i++) {
        cout << "  " << i << "  |";
    }
    //skull emoji unicode
    cout << "  \U0001F480  |" << endl;

    cout << "-------------------------------------------------------------" << endl;

    // Player position
    cout << "|";
    for (int j = 1; j <= 10; j++) {
        if (j == player_position) {
            cout << " You |";
        }
        else {
            cout << "     |";
        }
    }
    cout << endl;
    cout << "-------------------------------------------------------------" << endl;
}
