//roomtype
string getRandomRoomType() {
    int randomnum = (rand() % 10) + 1;
    if (randomnum >= 1 && randomnum <= 7) {
        return "mob";
    }
    else if (randomnum >= 8 && randomnum <= 9) {
        return "merchant";
    }
    else {
        return "treasure";
    }
}
string printHp(int player_health) {
    cout << "HP : ";
    for (int i = 0; i < player_health; i++) {
        cout << "*";
    }
    cout << endl;
    return "";
}
//end game
int EndGame(string name[], int player_position[], int health[]) {
    clearScreen();
    printBoard(name[0], player_position[0]);
    cout << "Hp= 0";
    bool end = false;
    if (player_position[0] >= 11) {
        cout << "Congratulations " << name[0] << "! , you have reached the end of the game!" << endl;
        end = true;
    }
    else if (health[0] <= 0) {
        cout << "Game Over! " << name[0] << " has lost all health." << endl;
        end = true;
    }
    if (end == true) {
        return 0;
    }
    else {
        return 1;
    }
}
